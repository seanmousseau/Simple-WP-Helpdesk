includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 9
    # Match CI's lowest PHP version (php-tests workflow matrix runs 8.1/8.2/8.3).
    # Without this, local analysis runs against the host PHP version (currently
    # 8.5+), which masks errors CI catches — e.g. non-falsy-string narrowing
    # on register_rest_route() that fired on PR #526 but passed locally.
    phpVersion: 80100
    treatPhpDocTypesAsCertain: false
    paths:
        - simple-wp-helpdesk/
    excludePaths:
        - simple-wp-helpdesk/vendor/
        # Portal v2 partial templates — variables injected via include() scope; not standalone files.
        - simple-wp-helpdesk/frontend/templates/portal-v2/
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
        - phpstan-bootstrap.php
        - phpstan-puc-stub.php
    scanDirectories:
        - simple-wp-helpdesk/vendor/
    # WordPress globals are not available in CLI context
    universalObjectCratesClasses:
        - wpdb
