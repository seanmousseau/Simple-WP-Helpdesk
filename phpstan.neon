includes:
    - vendor/szepeviktor/phpstan-wordpress/extension.neon

parameters:
    level: 9
    treatPhpDocTypesAsCertain: false
    paths:
        - simple-wp-helpdesk/
    excludePaths:
        - simple-wp-helpdesk/vendor/
        # Portal v2 partial templates — variables injected via include() scope; not standalone files.
        - simple-wp-helpdesk/frontend/templates/portal-v2/
    bootstrapFiles:
        - vendor/szepeviktor/phpstan-wordpress/bootstrap.php
        - phpstan-bootstrap.php
        - phpstan-puc-stub.php
    scanDirectories:
        - simple-wp-helpdesk/vendor/
    # WordPress globals are not available in CLI context
    universalObjectCratesClasses:
        - wpdb
